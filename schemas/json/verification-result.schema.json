{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trustledger.io/schemas/v1/verification-result.schema.json",
  "title": "VerificationResult",
  "description": "Canonical Verification Result contract output by TrustLedger Decision Gate.",
  "type": "object",
  "required": [
    "contract_version",
    "decision_id",
    "verdict",
    "confidence",
    "risk_level",
    "evidence_result",
    "policy_result",
    "consistency_result",
    "ai_result",
    "reasons",
    "missing_evidence",
    "verification_started_at",
    "verification_completed_at",
    "verifier_version"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "trustledger.contract.v1"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "enum": ["APPROVE", "REVIEW", "BLOCK"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "risk_level": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "evidence_result": {
      "type": "object",
      "required": ["evidence_score", "verified_count", "missing_references"],
      "properties": {
        "evidence_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "verified_count": { "type": "integer", "minimum": 0 },
        "missing_references": { "type": "array", "items": { "type": "string" } }
      }
    },
    "policy_result": {
      "type": "object",
      "required": ["passed", "violations"],
      "properties": {
        "passed": { "type": "boolean" },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["policy_id", "rule_id", "message"],
            "properties": {
              "policy_id": { "type": "string" },
              "rule_id": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "consistency_result": {
      "type": "object",
      "required": ["is_consistent", "contradictions"],
      "properties": {
        "is_consistent": { "type": "boolean" },
        "contradictions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ai_result": {
      "type": "object",
      "required": ["verdict_recommendation", "reasoning_summary", "detected_risk_factors", "confidence"],
      "properties": {
        "verdict_recommendation": { "type": "string", "enum": ["APPROVE", "REVIEW", "BLOCK"] },
        "reasoning_summary": { "type": "string" },
        "detected_risk_factors": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "missing_evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verification_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "verification_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "verifier_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
