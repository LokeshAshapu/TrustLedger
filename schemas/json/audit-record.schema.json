{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trustledger.io/schemas/v1/audit-record.schema.json",
  "title": "AuditRecord",
  "description": "Canonical Audit Record contract for append-only decision trace logging.",
  "type": "object",
  "required": [
    "contract_version",
    "event_id",
    "decision_id",
    "event_type",
    "actor_type",
    "actor_id",
    "timestamp",
    "new_state",
    "reason",
    "correlation_id"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "trustledger.contract.v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "actor_type": {
      "type": "string",
      "enum": ["AI_AGENT", "TRUSTLEDGER", "HUMAN", "FINANCIAL_SYSTEM"]
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "previous_state": {
      "type": ["string", "null"],
      "enum": [
        "RECEIVED",
        "NORMALIZED",
        "EVIDENCE_CHECK",
        "POLICY_CHECK",
        "CONSISTENCY_CHECK",
        "RISK_ASSESSMENT",
        "AI_VERIFICATION",
        "VERDICT",
        "READY_FOR_EXECUTION",
        "HUMAN_REVIEW",
        "BLOCKED",
        "EXECUTING",
        "EXECUTED",
        "FAILED",
        null
      ]
    },
    "new_state": {
      "type": "string",
      "enum": [
        "RECEIVED",
        "NORMALIZED",
        "EVIDENCE_CHECK",
        "POLICY_CHECK",
        "CONSISTENCY_CHECK",
        "RISK_ASSESSMENT",
        "AI_VERIFICATION",
        "VERDICT",
        "READY_FOR_EXECUTION",
        "HUMAN_REVIEW",
        "BLOCKED",
        "EXECUTING",
        "EXECUTED",
        "FAILED"
      ]
    },
    "reason": {
      "type": "string"
    },
    "metadata": {
      "type": ["object", "null"]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
