{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trustledger.io/schemas/v1/policy-snapshot.schema.json",
  "title": "PolicySnapshot",
  "description": "Canonical Policy Snapshot contract representing versioned reproducible merchant rules.",
  "type": "object",
  "required": [
    "contract_version",
    "policy_id",
    "merchant_id",
    "action_type",
    "rules",
    "effective_from",
    "policy_version"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "trustledger.contract.v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "merchant_id": {
      "type": "string",
      "minLength": 1
    },
    "action_type": {
      "type": "string",
      "enum": ["REFUND", "DISCOUNT", "PAYMENT_RECOVERY", "PAYOUT"]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "rule_name", "is_hard_constraint"],
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 },
          "rule_name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "threshold_value": {},
          "is_hard_constraint": { "type": "boolean" }
        }
      }
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "effective_until": {
      "type": ["string", "null"]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
