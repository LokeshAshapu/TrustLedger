# TrustLedger AI Contextual Verification Engine Environment Configuration
# Copy this file to .env and insert your API credentials

# AI Provider Configuration (Options: nvidia, openai, mock)
AI_PROVIDER=nvidia
AI_MODEL=meta/llama-3.1-70b-instruct
AI_TIMEOUT_SECONDS=10

# API Credentials (Set via environment variable, NEVER commit actual keys)
NVIDIA_API_KEY=your_nvidia_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Razorpay Test-Mode Refund Client Configuration (Phase 11B.1 Server-Side Client)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com
RAZORPAY_TIMEOUT_SECONDS=10
RAZORPAY_MAX_ATTEMPTS=2
RAZORPAY_ENVIRONMENT=test
# Optional test payment ID for opt-in live smoke test
RAZORPAY_TEST_PAYMENT_ID=
